# ── X-Plane Virtual ATC — local config ──────────────────────────────────────
# Copy this file to `.env`, or just set these in the app's Settings view.
#
# The defaults need two things:
#   1. A Claude subscription — the controller's brain. Nothing goes here; the
#      app uses the `claude` CLI you sign into separately.
#   2. An ElevenLabs API key (below) — the default provider for BOTH the
#      controller's voice (text-to-speech) and understanding you (speech-to-text).

# Required for speech in/out. Create a key at:
#   https://elevenlabs.io/app/developers/api-keys
# Give the key these permissions (or leave it unrestricted):
#   • Text to Speech  — access   (the controller's voice)
#   • Speech to Text  — access   (transcribes what you say)
#   • User            — read     (lets the app verify the key on startup)
ELEVENLABS_API_KEY=

# X-Plane install path — only needed if it's NOT in the default Steam location.
# Used to find apt.dat (airport data). The Settings view can set this too.
# XPLANE_PATH=/Applications/X-Plane 12

# Push-to-talk: bind your key to the "xPilot: Radio Push-to-Talk" command and
# leave this as-is. Empty = use the on-screen button / spacebar instead.
XPLANE_PTT_DATAREF=xpilot/ptt

# Auto-set a "VFR day" once at startup, as soon as X-Plane is connected and a
# flight is loaded: real weather frozen (wind/pressure/temp stay real), a few
# scattered clouds, visibility > 5 sm, local noon. Same as the VFR Day button.
# VFR_WEATHER_ON_START=true

# Optional — alternative voice provider (used only if no ElevenLabs key):
# OPENAI_API_KEY=
