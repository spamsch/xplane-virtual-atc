{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "X-Plane Virtual ATC",
  "version": "0.1.3",
  "identifier": "com.virtualatc.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Virtual ATC",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' http://localhost:1420; connect-src 'self' ws://localhost:8765 ws://localhost:1420 ws://localhost:1421 http://localhost:1420; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' http://localhost:1420"
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist"
    }
  }
}
