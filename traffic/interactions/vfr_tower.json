{
  "_comment": "VFR tower chatter — departures, the circuit, landings, traffic info.",
  "interactions": [
    {
      "id": "twr_ready_departure",
      "station": "tower",
      "flight_rules": "VFR",
      "sizes": ["small", "medium", "large"],
      "lines": [
        { "speaker": "pilot", "text": "{atc_callsign}, {callsign}, holding point runway {runway}, ready for departure." },
        { "speaker": "atc",   "text": "{callsign}, runway {runway}, wind {wind}, cleared for take-off." },
        { "speaker": "pilot", "text": "Cleared for take-off runway {runway}, {callsign}." }
      ]
    },
    {
      "id": "twr_landing_clearance",
      "station": "tower",
      "flight_rules": "VFR",
      "sizes": ["small", "medium", "large"],
      "lines": [
        { "speaker": "pilot", "text": "{atc_callsign}, {callsign}, left base runway {runway}." },
        { "speaker": "atc",   "text": "{callsign}, number one, runway {runway}, wind {wind}, cleared to land." },
        { "speaker": "pilot", "text": "Cleared to land runway {runway}, {callsign}." }
      ]
    },
    {
      "id": "twr_traffic_number_two",
      "station": "tower",
      "flight_rules": "VFR",
      "sizes": ["medium", "large"],
      "lines": [
        { "speaker": "pilot", "text": "{atc_callsign}, {callsign}, downwind runway {runway}, touch and go." },
        { "speaker": "atc",   "text": "{callsign}, number two, traffic on final is a Cessna, report runway in sight." },
        { "speaker": "pilot", "text": "Number two, looking for traffic, {callsign}." }
      ]
    },
    {
      "id": "twr_join_circuit",
      "station": "tower",
      "flight_rules": "VFR",
      "sizes": ["small", "medium"],
      "lines": [
        { "speaker": "pilot", "text": "{atc_callsign}, {callsign}, 5 miles south, inbound for landing with information, request joining." },
        { "speaker": "atc",   "text": "{callsign}, join right downwind runway {runway}, QNH {qnh}, report downwind." },
        { "speaker": "pilot", "text": "Join right downwind runway {runway}, QNH {qnh}, {callsign}." }
      ]
    },
    {
      "id": "twr_after_departure",
      "station": "tower",
      "flight_rules": "VFR",
      "sizes": ["small", "medium", "large"],
      "weight": 0.8,
      "lines": [
        { "speaker": "pilot", "text": "{atc_callsign}, {callsign}, leaving the zone to the east, request frequency change." },
        { "speaker": "atc",   "text": "{callsign}, frequency change approved, squawk 7000, good day." }
      ]
    },
    {
      "id": "twr_go_around",
      "station": "tower",
      "flight_rules": "VFR",
      "sizes": ["medium", "large"],
      "weight": 0.5,
      "lines": [
        { "speaker": "atc",   "text": "{callsign}, go around, traffic on the runway, climb runway heading." },
        { "speaker": "pilot", "text": "Going around, runway heading, {callsign}." }
      ]
    },
    {
      "id": "twr_extend_downwind",
      "station": "tower",
      "flight_rules": "VFR",
      "sizes": ["medium", "large"],
      "weight": 0.5,
      "lines": [
        { "speaker": "atc",   "text": "{callsign}, extend downwind, number two, traffic on a long final." },
        { "speaker": "pilot", "text": "Extending downwind, number two, {callsign}." }
      ]
    },
    {
      "id": "twr_orbit_spacing",
      "station": "tower",
      "flight_rules": "VFR",
      "sizes": ["medium", "large"],
      "weight": 0.4,
      "lines": [
        { "speaker": "atc",   "text": "{callsign}, orbit left for spacing, report back on downwind runway {runway}." },
        { "speaker": "pilot", "text": "Orbit left, wilco, {callsign}." }
      ]
    },
    {
      "id": "twr_land_after",
      "station": "tower",
      "flight_rules": "VFR",
      "sizes": ["medium", "large"],
      "weight": 0.5,
      "lines": [
        { "speaker": "pilot", "text": "{atc_callsign}, {callsign}, final runway {runway}." },
        { "speaker": "atc",   "text": "{callsign}, land after the departing traffic, runway {runway}, wind {wind}." },
        { "speaker": "pilot", "text": "Land after the departing traffic, runway {runway}, {callsign}." }
      ]
    },
    {
      "id": "twr_blocked_transmission",
      "station": "tower",
      "flight_rules": "VFR",
      "sizes": ["small", "medium", "large"],
      "weight": 0.4,
      "lines": [
        { "speaker": "atc",   "text": "Station calling Tower, you were blocked, say again." },
        { "speaker": "pilot", "text": "{atc_callsign}, {callsign}, ready for departure, runway {runway}." },
        { "speaker": "atc",   "text": "{callsign}, runway {runway}, wind {wind}, cleared for take-off." }
      ]
    },
    {
      "id": "twr_lineup_wait",
      "station": "tower",
      "flight_rules": "VFR",
      "sizes": ["medium", "large"],
      "lines": [
        { "speaker": "pilot", "text": "{atc_callsign}, {callsign}, holding point runway {runway}, ready." },
        { "speaker": "atc",   "text": "{callsign}, line up runway {runway} and wait." },
        { "speaker": "pilot", "text": "Line up and wait runway {runway}, {callsign}." }
      ]
    },
    {
      "id": "twr_immediate_takeoff",
      "station": "tower",
      "flight_rules": "VFR",
      "sizes": ["medium", "large"],
      "weight": 0.5,
      "lines": [
        { "speaker": "atc",   "text": "{callsign}, runway {runway}, cleared for immediate take-off, traffic 3 miles final." },
        { "speaker": "pilot", "text": "Immediate take-off runway {runway}, {callsign}." }
      ]
    },
    {
      "id": "twr_hold_short_landing",
      "station": "tower",
      "flight_rules": "VFR",
      "sizes": ["small", "medium", "large"],
      "weight": 0.6,
      "lines": [
        { "speaker": "pilot", "text": "{atc_callsign}, {callsign}, holding point runway {runway}, ready for departure." },
        { "speaker": "atc",   "text": "{callsign}, hold short runway {runway}, landing traffic." },
        { "speaker": "pilot", "text": "Holding short runway {runway}, {callsign}." }
      ]
    },
    {
      "id": "twr_continue_approach",
      "station": "tower",
      "flight_rules": "VFR",
      "sizes": ["medium", "large"],
      "weight": 0.5,
      "lines": [
        { "speaker": "pilot", "text": "{atc_callsign}, {callsign}, final runway {runway}." },
        { "speaker": "atc",   "text": "{callsign}, continue approach, runway {runway}, expect late landing clearance, traffic vacating." },
        { "speaker": "pilot", "text": "Continue approach runway {runway}, {callsign}." }
      ]
    },
    {
      "id": "twr_cleared_option",
      "station": "tower",
      "flight_rules": "VFR",
      "sizes": ["small", "medium"],
      "lines": [
        { "speaker": "pilot", "text": "{atc_callsign}, {callsign}, downwind runway {runway}, request the option." },
        { "speaker": "atc",   "text": "{callsign}, runway {runway}, wind {wind}, cleared for the option." },
        { "speaker": "pilot", "text": "Cleared for the option runway {runway}, {callsign}." }
      ]
    },
    {
      "id": "twr_report_final",
      "station": "tower",
      "flight_rules": "VFR",
      "sizes": ["small", "medium", "large"],
      "weight": 0.7,
      "lines": [
        { "speaker": "pilot", "text": "{atc_callsign}, {callsign}, downwind runway {runway}, full stop." },
        { "speaker": "atc",   "text": "{callsign}, number one, report final runway {runway}." },
        { "speaker": "pilot", "text": "Report final runway {runway}, {callsign}." }
      ]
    },
    {
      "id": "twr_wind_check",
      "station": "tower",
      "flight_rules": "VFR",
      "sizes": ["small", "medium", "large"],
      "weight": 0.5,
      "lines": [
        { "speaker": "pilot", "text": "{atc_callsign}, {callsign}, request wind check." },
        { "speaker": "atc",   "text": "{callsign}, wind {wind}." }
      ]
    },
    {
      "id": "twr_short_approach",
      "station": "tower",
      "flight_rules": "VFR",
      "sizes": ["medium", "large"],
      "weight": 0.4,
      "lines": [
        { "speaker": "atc",   "text": "{callsign}, make short approach runway {runway}, traffic behind you on a long final." },
        { "speaker": "pilot", "text": "Short approach runway {runway}, {callsign}." }
      ]
    },
    {
      "id": "twr_vacate_contact_ground",
      "station": "tower",
      "flight_rules": "VFR",
      "sizes": ["medium", "large"],
      "weight": 0.8,
      "lines": [
        { "speaker": "atc",   "text": "{callsign}, runway vacated, contact Ground, good day." },
        { "speaker": "pilot", "text": "Contact Ground, good day, {callsign}." }
      ]
    },
    {
      "id": "twr_zone_transit",
      "station": "tower",
      "flight_rules": "VFR",
      "sizes": ["medium", "large"],
      "weight": 0.6,
      "lines": [
        { "speaker": "pilot", "text": "{atc_callsign}, {callsign}, request transit of your control zone, VFR, 2000 feet." },
        { "speaker": "atc",   "text": "{callsign}, cleared to transit the zone, not above 2000 feet, squawk {squawk}, QNH {qnh}." },
        { "speaker": "pilot", "text": "Transit the zone not above 2000 feet, squawk {squawk}, QNH {qnh}, {callsign}." }
      ]
    },
    {
      "id": "twr_remain_outside",
      "station": "tower",
      "flight_rules": "VFR",
      "sizes": ["medium", "large"],
      "weight": 0.4,
      "lines": [
        { "speaker": "pilot", "text": "{atc_callsign}, {callsign}, 4 miles south, request joining." },
        { "speaker": "atc",   "text": "{callsign}, remain outside controlled airspace, expect join in 5 minutes, traffic in the circuit." },
        { "speaker": "pilot", "text": "Remaining outside, {callsign}." }
      ]
    },
    {
      "id": "twr_overhead_join",
      "station": "tower",
      "flight_rules": "VFR",
      "sizes": ["small", "medium"],
      "weight": 0.5,
      "lines": [
        { "speaker": "pilot", "text": "{atc_callsign}, {callsign}, inbound, request overhead join." },
        { "speaker": "atc",   "text": "{callsign}, join overhead 2000 feet, descend on the dead side, runway {runway}, QNH {qnh}." },
        { "speaker": "pilot", "text": "Overhead join, runway {runway}, QNH {qnh}, {callsign}." }
      ]
    },
    {
      "id": "twr_low_approach",
      "station": "tower",
      "flight_rules": "VFR",
      "sizes": ["small", "medium"],
      "weight": 0.4,
      "lines": [
        { "speaker": "pilot", "text": "{atc_callsign}, {callsign}, final runway {runway}, request low approach." },
        { "speaker": "atc",   "text": "{callsign}, runway {runway}, cleared low approach, report going around." },
        { "speaker": "pilot", "text": "Cleared low approach runway {runway}, {callsign}." }
      ]
    }
  ]
}
